# Ignore version control metadata
.git
.gitignore

# Ignore local dependencies (let Docker install them instead)
node_modules/
venv/
.venv/

# Ignore IDE settings and local configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Ignore build outputs and cache
dist/
build/
out/
target/
**/*.pyc
__pycache__/

# Ignore logs and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore secrets and environment variables
.env
.env.local
*.pem
*.key
